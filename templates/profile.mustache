{{!
    @template local_external_users/profile
}}

<div class="card-body mx-auto" style="max-width: 1200px">
    <div class="float-right">
        <form action="manage.php">
            <button class="btn btn-primary">{{back_label}}</button>
        </form>
    </div>
    <h3 class="lead">{{firstname}} {{middlename}} {{lastname}}</h3>
    <ul>
        <li class="contentnode">
            {{verified}}
        </li>
        <li class="contentnode">
            {{verifiedtill}}
        </li>
        <li class="contentnode">
            {{mail}}
        </li>
        <li class="contentnode">
            {{birthdate}}
        </li>
        <li class="contentnode">
            {{username}}
        </li>
        <li class="contentnode">
            {{affiliation}}
        </li>
    </ul>
    {{#userpiclink}}
        <div class="content">
            <h3>ID Card</h3>
            <p>
                <a href="#" data-toggle="modal" data-target="#imageModal">
                    <img src="{{{userpiclink}}}" alt="User image" class="img-thumbnail" style="max-height: 200px">
                </a>
            <div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="imageModalLabel">User image</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body text-center">
                            <img src="{{{userpiclink}}}" alt="User image" class="img-fluid">
                        </div>
                    </div>
                </div>
            </div>
            </p>
        </div>
    {{/userpiclink}}
    <div class="content">
        <h3>{{uploadedfiles_header}}</h3>
        <p>{{{filetable}}}</p>
    </div>
</div>



