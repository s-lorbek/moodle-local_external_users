{{!
    @template local_external_users/profile
}}

<div class="card p-4 mx-auto" style="max-width: 1200px;">
    <!-- Zurück-Button oben rechts -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0">
            {{firstname}} {{middlename}} {{lastname}}
        </h2>
        <form action="{{back_link}}">
            <button id="backButton" class="btn btn-sm btn-outline-primary">
                {{back_label}}
            </button>
        </form>
    </div>

    <!-- User-Infos in einer Tabelle / Liste -->
    <div class="row mb-4">
        <div class="col-12 col-lg-6">
            <dl class="row mb-0">
                <dt class="col-5">{{#str}}approved,local_external_users{{/str}}:</dt>
                <dd class="col-7">{{verified}}</dd>

                <dt class="col-5">{{#str}}approveduntil,local_external_users{{/str}}:</dt>
                <dd class="col-7">{{verifiedtill}}</dd>

                <dt class="col-5">{{#str}}mail,local_external_users{{/str}}:</dt>
                <dd class="col-7">{{mail}}</dd>

                <dt class="col-5">{{#str}}birthdate,local_external_users{{/str}}:</dt>
                <dd class="col-7">{{birthdate}}</dd>

                <dt class="col-5">{{#str}}username,local_external_users{{/str}}:</dt>
                <dd class="col-7">{{username}}</dd>

                <dt class="col-5">{{#str}}affiliation,local_external_users{{/str}}:</dt>
                <dd class="col-7">{{affiliation}}</dd>
            </dl>
        </div>

        <!-- User-Bild (ID Card) -->
        {{#userpiclink}}
            <div class="col-12 col-lg-6 text-center">
                <h3 class="h6 mb-2">{{#str}}idcard,local_external_users{{/str}}</h3>
                <p>
                    <a href="#" data-toggle="modal" data-target="#imageModal">
                        <img
                            src="{{{userpiclink}}}"
                            alt="User image"
                            class="img-thumbnail shadow-sm"
                            style="max-height: 200px; width: auto;"
                        >
                    </a>
                </p>
            </div>
        {{/userpiclink}}
    </div>

    <!-- Modal für großes Bild -->
    {{#userpiclink}}
        <div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="imageModalLabel">{{#str}}user_image,local_external_users{{/str}}</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body text-center">
                        <img
                            src="{{{userpiclink}}}"
                            alt="User image"
                            class="img-fluid rounded shadow"
                        >
                    </div>
                </div>
            </div>
        </div>
    {{/userpiclink}}

    <!-- Upload-Tabelle -->
    <div class="content mt-4">
        <h3 class="h5">{{uploadedfiles_header}}</h3>
        <div class="table-responsive">
            {{{filetable}}}
        </div>
    </div>
</div>