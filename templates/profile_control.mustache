{{!
    @template local_external_users/profile_control
}}
<div class="card-body mx-auto" style="max-width: 1200px">
    <form id="affiliationChange" action="affiliate.php">
        <input type="text" name="id" value="{{userid}}" hidden>
        <label for="affiliation">{{affiliation_label}}: </label>
        <select id="affiliation" name="affiliation" class="select custom-select cal_courses_flt ml-1 mr-auto"
                aria-label="Affiliation selection">
                <option> </option>
                {{#affiliation_options}}
                    <option {{#selected}}selected{{/selected}} value="{{value}}">{{value}}</option>
                {{/affiliation_options}}

        </select>
    </form>
</div>
<div class="card-body mx-auto" style="max-width: 1200px">
    <form action="approve.php">
        <input type="text" name="id" value="{{userid}}" hidden>
        <input type="text" name="type" value="{{action}}" hidden>
        <input type="text" name="referrer" value="{{referrer}}" hidden>
        {{#action}}
            <label for="price_category">eduScope:</label><br>
            <select class="select custom-select cal_courses_flt ml-1 mr-auto" name="tariff">
                <option value="student">student</option>
                <option value="staff">staff</option>
                <option value="external">external</option>
            </select>
        {{/action}}
        {{#approve}}
            <button name="submitButton" value="regular" class="btn btn-{{btn1_style}} ml-2">{{approve}}</button>
            <button name="submitButton" value="limited" class="btn btn-{{btn1_style}} ml-2">{{approve-limited}}</button>
            <button name="submitButton" value="limited2" class="btn btn-{{btn1_style}} ml-2">{{approve-limited2}}</button>
        {{/approve}}
        {{#revoke}}
            <button class="btn btn-{{btn1_style}}">{{revoke}}</button>
        {{/revoke}}
    </form>
    <hr>
    <form method="post" action="reject.php">
        <input type="text" name="id" value="{{userid}}" hidden>
        <input type="text" name="referrer" value="{{referrer}}" hidden>
        <fieldset>
            <legend>{{legend}}</legend>
            {{{options}}}
            <label for="comment">{{rejection_control_additional_comment}}</label><br>
            <textarea class="w-100" id="comment" name="comment" rows="4" cols="50">
        </textarea>
        </fieldset>
        <button class="btn btn-danger">{{rejection_header}}</button>
    </form>
    <hr>
</div>

{{#js}}
    {{#affiliation_options}}
        var e = document.getElementById('affiliation');
        var form = document.getElementById('affiliationChange');
        e.addEventListener("change", function() {
            form.submit();
        });
    {{/affiliation_options}}
{{/js}}
