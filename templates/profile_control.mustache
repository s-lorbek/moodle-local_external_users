{{!
    @template local_external_users/profile_control

    Profile control panel template.

    Example context (json):
    {
        "sesskey": "abc123xyz",
        "userid": 2,
        "referrer": "manage",
        "affiliation_label": "Affiliation",
        "affiliation_options": [
            {"value": "Uni Graz", "selected": true},
            {"value": "TU Graz", "selected": false}
        ],
        "verify_mode": 1,
        "is_unverified": true,
        "price_categories": ["tariff_a", "tariff_b"],
        "btn1_style": "primary",
        "approve": "Approve",
        "approve-limited": "Approve Limited (WS26)",
        "approve-limited2": "Approve Limited (SS27)",
        "legend": "Rejection Options",
        "options": "<div><input type='radio' name='reject' id='opt1' value='0'><label for='opt1'>Mail only</label></div>",
        "rejection_control_additional_comment": "Additional comment",
        "rejection_header": "Reject User"
    }
}}
<div class="card shadow-sm mx-auto mb-4" style="max-width: 1200px;">
    <div class="card-header bg-light">
        <h3 class="h5 mb-0 text-secondary"><i class="fa fa-cogs mr-2"></i>{{#str}}controls,local_external_users{{/str}}</h3>
    </div>
    <div class="card-body p-0">
        <ul class="list-group list-group-flush">
            <!-- Affiliation Section -->
            <li class="list-group-item p-4">
                <form id="affiliationChange" action="action.php" method="post" class="form-inline">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="affiliate">
                    <input type="hidden" name="id" value="{{userid}}">
                    <input type="hidden" name="referrer" value="{{referrer}}">
                    
                    <div class="form-group mb-0 mr-3">
                        <label for="affiliation" class="font-weight-bold mr-2 text-dark">{{affiliation_label}}:</label>
                        <select id="affiliation" name="affiliation" class="custom-select custom-select-sm">
                            <option value="" label=" "> </option>
                            {{#affiliation_options}}
                                <option {{#selected}}selected{{/selected}} value="{{value}}">{{value}}</option>
                            {{/affiliation_options}}
                        </select>
                    </div>
                    <small class="text-muted"><i class="fa fa-info-circle mr-1"></i>{{#str}}affiliation_help,local_external_users{{/str}}</small>
                </form>
            </li>

            <!-- Approval Section -->
            <li class="list-group-item p-4">
                <form action="action.php" method="post">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="approve">
                    <input type="hidden" name="id" value="{{userid}}">
                    <input type="hidden" name="referrer" value="{{referrer}}">
                    <input type="hidden" name="type" value="{{verify_mode}}">

                    <div class="row align-items-end">
                        {{#is_unverified}}
                            <div class="col-md-4">
                                <div class="form-group mb-3 mb-md-0">
                                    <label for="tariff" class="font-weight-bold text-dark">eduScope (Tariff):</label>
                                    <select class="custom-select" name="tariff" id="tariff">
                                    {{#price_categories}}
                                        <option value="{{.}}">{{.}}</option>
                                    {{/price_categories}}
                                    </select>
                                </div>
                            </div>
                        {{/is_unverified}}

                        <div class="col-md">
                            <div class="d-flex flex-wrap">
                                {{#approve}}
                                    <button name="submitButton" value="regular" class="btn btn-{{btn1_style}} mr-2 mb-2">
                                        <i class="fa fa-check-circle mr-1"></i>{{approve}}
                                    </button>
                                    <button name="submitButton" value="limited" class="btn btn-outline-{{btn1_style}} mr-2 mb-2">
                                        <i class="fa fa-calendar-check-o mr-1"></i>{{approve-limited}}
                                    </button>
                                    <button name="submitButton" value="limited2" class="btn btn-outline-{{btn1_style}} mr-2 mb-2">
                                        <i class="fa fa-calendar-plus-o mr-1"></i>{{approve-limited2}}
                                    </button>
                                {{/approve}}

                                {{#revoke}}
                                    <button class="btn btn-{{btn1_style}} shadow-sm">
                                        <i class="fa fa-undo mr-1"></i>{{revoke}}
                                    </button>
                                {{/revoke}}
                            </div>
                        </div>
                    </div>
                </form>
            </li>

            <!-- Rejection Section -->
            <li class="list-group-item p-4 bg-light-danger">
                <form method="post" action="action.php">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="reject">
                    <input type="hidden" name="id" value="{{userid}}">
                    <input type="hidden" name="referrer" value="{{referrer}}">
                    
                    <h4 class="h6 font-weight-bold text-danger mb-3">
                        <i class="fa fa-times-circle mr-1"></i>{{legend}}
                    </h4>
                    
                    <div class="mb-3">
                        {{{options}}}
                    </div>
                    
                    <div class="form-group">
                        <label for="comment" class="font-weight-bold">{{rejection_control_additional_comment}}</label>
                        <textarea class="form-control" id="comment" name="comment" rows="3" placeholder="{{#str}}comment_placeholder,local_external_users{{/str}}"></textarea>
                    </div>
                    
                    <button class="btn btn-danger px-4">
                        <i class="fa fa-trash-o mr-1"></i>{{rejection_header}}
                    </button>
                </form>
            </li>
        </ul>
    </div>
</div>

{{#js}}
    const affiliationSelect = document.getElementById('affiliation');
    if (affiliationSelect) {
        affiliationSelect.addEventListener('change', function() {
            const form = document.getElementById('affiliationChange');
            if (form) {
                form.submit();
            }
        });
    }
{{/js}}
