<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/external_users/db" VERSION="2020191000" COMMENT="XMLDB file for Moodle local/external_users"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_external_users_files" COMMENT="External Users">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="contextid" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Context"/>
        <FIELD NAME="component" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Plugin"/>
        <FIELD NAME="filearea" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Defined file area"/>
        <FIELD NAME="filepath" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Location of file"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="File owner"/>
        <FIELD NAME="filename" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="File name"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
