{{!
    @template local_external_users/profile

    User profile template.

    Example context (json):
    {
        "back_link": "http://example.com/manage.php",
        "back_label": "Back",
        "firstname": "John",
        "middlename": "",
        "lastname": "Doe",
        "username": "johndoe",
        "mail": "john@example.com",
        "birthdate": "01.01.1990",
        "affiliation": "University",
        "eduScope": "tariff_a",
        "verified": "Yes",
        "verifiedtill": "-",
        "moodle_profile_link": "http://example.com/user/view.php?id=2",
        "uploadedfiles_header": "Uploaded files",
        "filetable": "<table><tr><td>file.pdf</td></tr></table>",
        "userpiclink": "http://example.com/image.jpg"
    }
}}

<div class="card shadow-sm mb-3 mx-auto" style="max-width: 1200px;">
    <div class="card-header d-flex justify-content-between align-items-center bg-white py-3">
        <h2 class="h4 mb-0 text-primary">
            <i class="fa fa-user-circle-o mr-2"></i>{{firstname}} {{middlename}} {{lastname}}
        </h2>
        <div class="d-flex">
            <a href="{{moodle_profile_link}}" class="btn btn-sm btn-outline-info mr-2" target="_blank">
                <i class="fa fa-external-link mr-1"></i>{{#str}}moodle_profile, local_external_users{{/str}}
            </a>
            <form action="{{back_link}}">
                <button id="backButton" class="btn btn-sm btn-outline-secondary">
                    <i class="fa fa-arrow-left mr-1"></i>{{back_label}}
                </button>
            </form>
        </div>
    </div>

    <div class="card-body">
        <!-- User-Infos -->
        <div class="row">
            <div class="col-12 col-lg-7">
                <table class="table table-sm table-borderless table-striped">
                    <tbody>
                    <tr>
                        <th class="w-35 text-muted">{{#str}}username, local_external_users{{/str}}:</th>
                        <td class="font-weight-bold">{{username}}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">{{#str}}mail, local_external_users{{/str}}:</th>
                        <td><a href="mailto:{{mail}}">{{mail}}</a></td>
                    </tr>
                    <tr>
                        <th class="text-muted">{{#str}}birthdate, local_external_users{{/str}}:</th>
                        <td>{{birthdate}}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">{{#str}}affiliation, local_external_users{{/str}}:</th>
                        <td>{{affiliation}}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">{{#str}}edupersonscopedaffiliation, local_external_users{{/str}}:</th>
                        <td><span class="badge badge-info">{{eduScope}}</span></td>
                    </tr>
                    <tr>
                        <th class="text-muted">{{#str}}verified, local_external_users{{/str}}:</th>
                        <td><span class="badge badge-light border">{{verified}}</span></td>
                    </tr>
                    <tr>
                        <th class="text-muted">{{#str}}verifiedtill, local_external_users{{/str}}:</th>
                        <td><span class="badge badge-light border">{{verifiedtill}}</span></td>
                    </tr>
                    </tbody>
                </table>
            </div>

            {{#userpiclink}}
                <div class="col-12 col-lg-5 text-center mt-3 mt-lg-0">
                    <div class="p-2 border rounded bg-light d-inline-block">
                        <a href="#" data-toggle="modal" data-target="#imageModal">
                            <img
                                src="{{{userpiclink}}}"
                                alt="User image"
                                class="img-fluid rounded shadow-sm hover-zoom"
                                style="max-height: 250px; cursor: zoom-in;"
                            >
                        </a>
                        <div class="mt-2 small text-muted">
                            <i class="fa fa-search-plus mr-1"></i>{{#str}}click_to_enlarge,local_external_users{{/str}}
                        </div>
                    </div>
                </div>
            {{/userpiclink}}
        </div>

        <!-- Upload-Tabelle -->
        <div class="mt-5">
            <h3 class="h5 mb-3 border-bottom pb-2">{{uploadedfiles_header}}</h3>
            <div class="table-responsive">
                {{{filetable}}}
            </div>
        </div>
    </div>
</div>

<!-- Modal für großes Bild -->
{{#userpiclink}}
    <div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalLabel">{{#str}}user_image,local_external_users{{/str}}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <img
                        src="{{{userpiclink}}}"
                        alt="User image"
                        class="img-fluid rounded shadow"
                    >
                </div>
            </div>
        </div>
    </div>
{{/userpiclink}}
